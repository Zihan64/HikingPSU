ANTHROPIC_API_KEY=sk-ant-...
# Set to 1 to run without the API (offline demo fallback)
DEMO_MODE=0
HIKINGPSU_MODEL=claude-sonnet-5-5

# User database (accounts, profiles, hike log, chat history). Without it the app still runs;
# /me returns 503 and /chat stays anonymous.
# Local:  mongodb://localhost:27017   Atlas: mongodb+srv://<user>:<pass>@<cluster>/
MONGODB_URI=
MONGODB_DB=hikingpsu

# Login (Auth0). Neither value is secret. Without them /me returns 503 and /chat stays anonymous.
AUTH0_DOMAIN=dev-mg84bneq57evnv54.us.auth0.com
AUTH0_AUDIENCE=https://api.hikingpsu

# Abuse limits (optional; defaults shown). Past the global cap, chat falls back to offline answers.
# CHAT_LIMIT_GLOBAL_PER_DAY=1000
# Signs assistant replies so clients cannot forge chat history. Needed only with several workers.
# CHAT_SIGNING_KEY=
