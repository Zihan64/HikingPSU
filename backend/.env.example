ANTHROPIC_API_KEY=sk-ant-...
# Set to 1 to run without the API (offline demo fallback)
DEMO_MODE=0
TRAILHEAD_MODEL=claude-sonnet-4-5

# User database (accounts, profiles, hike log, chat history). Without it the app still runs;
# /auth and /me return 503 and /chat stays anonymous.
# Local:  mongodb://localhost:27017   Atlas: mongodb+srv://<user>:<pass>@<cluster>/
MONGODB_URI=
MONGODB_DB=hikingpsu
# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
