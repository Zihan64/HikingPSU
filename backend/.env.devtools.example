# Copy to backend/.env.devtools.local (ignored). Keep this service separate from production.
HIKINGPSU_ENV=development
DEVTOOLS_ENABLED=1
# Exact origin; HTTPS required except localhost/127.0.0.1.
DEVTOOLS_ORIGIN=http://127.0.0.1:5176
# Separate Auth0 Regular Web Application. Client secret stays on the server.
DEVTOOLS_AUTH0_DOMAIN=
DEVTOOLS_AUTH0_CLIENT_ID=
DEVTOOLS_AUTH0_CLIENT_SECRET=
# Separate Auth0 API identifier; enable RBAC and permissions in access tokens.
DEVTOOLS_AUTH0_AUDIENCE=
DEVTOOLS_PRODUCTION_AUDIENCE=https://api.hikingpsu
DEVTOOLS_PRODUCTION_CLIENT_ID=
# At least 32 random characters. Never use a VITE_* variable for this value.
DEVTOOLS_SESSION_SECRET=
# Relative to the backend working directory.
DEVTOOLS_ALLOWLIST_FILE=devtools.allowlist.json
DEVTOOLS_ASSET_DIR=../frontend/.devtools-dist
# No MONGODB_URI, production Auth0 management credentials or real LLM keys needed.
